[{"text": "ไม่ใช่ทุกคลาสสิก", "start": 0, "end": 1.04}, {"text": "เอ", "start": 1.14, "end": 1.48}, {"text": "หรือคลาสสิก", "start": 1.58, "end": 2.34}, {"text": "วี", "start": 2.42, "end": 2.54}, {"text": "ที่น่าเทรด", "start": 2.61, "end": 3.7}, {"text": "มาดูวิธีแยกตัวที่แข็งแรง", "start": 3.8, "end": 5.62}, {"text": "กับตัวที่อ่อน", "start": 5.79, "end": 6.72}, {"text": "กฎข้อแรก", "start": 7.16, "end": 7.98}, {"text": "ไส้เทียนไม่สำคัญ", "start": 8.16, "end": 9.67}, {"text": "ระดับคือราคาปิดของเนื้อเทียนแท่งแรก", "start": 10.23, "end": 12.77}, {"text": "แท่งก่อนที่ราคาจะกลับตัว", "start": 13.16, "end": 14.87}, {"text": "แบบนี้", "start": 15.34, "end": 15.72}, {"text": "ถึงแท่งที่สองจะเปิดแก๊ป", "start": 16.21, "end": 17.88}, {"text": "ระดับของเราก็ไม่เปลี่ยน", "start": 18.03, "end": 19.48}, {"text": "คลาสสิก", "start": 19.52, "end": 20.42}, {"text": "เอ", "start": 20.46, "end": 20.73}, {"text": "ที่แข็งแรง", "start": 20.77, "end": 21.54}, {"text": "แท่งที่สองต้องปิดต่ำกว่าราคาเปิดของแท่งแรก", "start": 22.01, "end": 25.0}, {"text": "กลืนเนื้อเทียนทั้งแท่ง", "start": 25.16, "end": 27.35}, {"text": "ที่แข็งแรงกว่านั้น", "start": 27.34, "end": 28.66}, {"text": "แท่งที่สองกวาดไฮของแท่งแรกก่อน", "start": 28.65, "end": 31.39}, {"text": "แล้วค่อยปิดลง", "start": 31.38, "end": 32.48}, {"text": "ลิควิดิตี้ถูกเก็บ", "start": 32.47, "end": 33.54}, {"text": "ฝั่งขายคุมเกม", "start": 33.67, "end": 34.95}, {"text": "ส่วนคลาสสิก", "start": 35.4, "end": 36.52}, {"text": "วี", "start": 36.53, "end": 36.65}, {"text": "กลับด้านกัน", "start": 36.66, "end": 37.52}, {"text": "แท่งที่สองปิดเหนือราคาเปิดของแท่งแรก", "start": 37.65, "end": 40.55}, {"text": "ถ้ากวาดโลว์ก่อนจะยิ่งดี", "start": 40.73, "end": 42.43}, {"text": "บนทองคำ", "start": 42.98, "end": 43.74}, {"text": "คลาสสิก", "start": 43.75, "end": 44.52}, {"text": "เอ", "start": 44.53, "end": 44.78}, {"text": "ที่แข็งแรง", "start": 44.79, "end": 45.59}, {"text": "ยืนได้ตอนรีเทสต์", "start": 45.85, "end": 47.35}, {"text": "ส่วนตัวที่อ่อน", "start": 47.4, "end": 48.46}, {"text": "แท่งที่สองปิดต่ำลงนิดเดียว", "start": 48.54, "end": 50.77}, {"text": "ราคาเบรกผ่านไปเลย", "start": 50.95, "end": 52.26}, {"text": "ตอนต่อไป", "start": 52.6, "end": 53.3}, {"text": "ไส้เทียนห้าสิบเปอร์เซ็นต์", "start": 53.43, "end": 54.17}]