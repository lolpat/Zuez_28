[{"text": "ก่อนเข้าออเดอร์ไหน", "start": 0.02, "end": 1.06}, {"text": "อ่านสตอรี่ไลน์ก่อน", "start": 1.47, "end": 2.68}, {"text": "ราคามาจากไหน", "start": 3.04, "end": 4.1}, {"text": "ตอนนี้อยู่ตรงไหน", "start": 4.45, "end": 5.61}, {"text": "และน่าจะไปทางไหนต่อ", "start": 5.83, "end": 7.46}, {"text": "กราฟคือลำดับของเหตุการณ์", "start": 7.76, "end": 9.77}, {"text": "แรงดัน", "start": 9.96, "end": 10.53}, {"text": "พักตัว", "start": 10.82, "end": 11.41}, {"text": "ตอบสนอง", "start": 11.71, "end": 12.3}, {"text": "แล้วไปต่อ", "start": 12.58, "end": 13.42}, {"text": "หรือกลับตัว", "start": 13.45, "end": 14.33}, {"text": "สตอรี่ไลน์เริ่มด้วยสามขั้น", "start": 14.78, "end": 16.57}, {"text": "หนึ่ง", "start": 16.77, "end": 17.54}, {"text": "ราคาแตะระดับที่ยังสด", "start": 17.74, "end": 19.28}, {"text": "สอง", "start": 19.5, "end": 20.29}, {"text": "ราคาปฏิเสธด้วยไส้เทียน", "start": 20.51, "end": 22.15}, {"text": "และแท่งปิดแล้ว", "start": 22.2, "end": 23.25}, {"text": "สาม", "start": 23.38, "end": 24.01}, {"text": "ไทม์เฟรมที่เล็กลงหนึ่งขั้น", "start": 24.14, "end": 25.99}, {"text": "ต้องเบรกให้ครบ", "start": 26.19, "end": 27.13}, {"text": "บนกราฟรายวัน", "start": 27.44, "end": 28.56}, {"text": "ราคาปฏิเสธระดับสำคัญที่ยังสด", "start": 28.95, "end": 31.09}, {"text": "ตอนนี้รอการเบรกบนกราฟสี่ชั่วโมง", "start": 31.18, "end": 33.93}, {"text": "ที่ไหนที่สตอรี่ไลน์หนึ่งจบ", "start": 34.1, "end": 35.92}, {"text": "สตอรี่ไลน์ฝั่งตรงข้ามจะเริ่มต้น", "start": 36.23, "end": 38.28}, {"text": "ตอนต่อไป", "start": 38.58, "end": 39.3}, {"text": "ระดับสด", "start": 39.76, "end": 40.36}, {"text": "และไม่สด", "start": 40.65, "end": 41.31}]