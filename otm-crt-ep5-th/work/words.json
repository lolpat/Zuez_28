[{"text": "ก่อนเข้าเทรดซีอาร์ทีทุกครั้ง", "start": 0, "end": 1.74}, {"text": "ไล่เช็กลิสต์นี้", "start": 1.88, "end": 2.9}, {"text": "หนึ่ง", "start": 3.2, "end": 4.15}, {"text": "แท่งเทียนไทม์เฟรมใหญ่", "start": 4.45, "end": 5.56}, {"text": "กำหนดกรอบ", "start": 5.85, "end": 6.68}, {"text": "สอง", "start": 6.9, "end": 7.68}, {"text": "ราคากวาดไปฝั่งหนึ่ง", "start": 7.9, "end": 9.38}, {"text": "สาม", "start": 9.55, "end": 10.26}, {"text": "มีแท่งเทียนปิดกลับเข้ามาในกรอบ", "start": 10.43, "end": 12.32}, {"text": "สี่", "start": 12.6, "end": 12.72}, {"text": "ไทม์เฟรมเล็กเปลี่ยนโครงสร้าง", "start": 13.01, "end": 15.1}, {"text": "แล้วเข้าที่กึ่งกลางของแฟร์แวลูแก็ป", "start": 15.32, "end": 17.61}, {"text": "ห้า", "start": 17.69, "end": 18.0}, {"text": "สต็อปเลยไส้เทียน", "start": 18.07, "end": 19.82}, {"text": "เป้าหมายอีกฝั่งของกรอบ", "start": 20.02, "end": 21.32}, {"text": "ขาดข้อไหนไป", "start": 21.46, "end": 22.5}, {"text": "ก็ไม่มีเทรด", "start": 22.62, "end": 23.63}, {"text": "เซฟไว้", "start": 23.78, "end": 24.38}, {"text": "แล้วเช็กก่อนกดซื้อหรือขายทุกครั้ง", "start": 24.74, "end": 26.85}, {"text": "คุณใช้คู่ไหน", "start": 27.24, "end": 28.14}, {"text": "สี่ชั่วโมงกับห้านาที", "start": 28.4, "end": 29.8}, {"text": "หรือรายวันกับหนึ่งชั่วโมง", "start": 30.16, "end": 31.85}, {"text": "บอกกันในคอมเมนต์", "start": 32.03, "end": 33.33}, {"text": "Order", "start": 33.34, "end": 33.77}, {"text": "the", "start": 33.71, "end": 33.95}, {"text": "market...", "start": 33.89, "end": 34.29}, {"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ", "start": 34.79, "end": 36.49}, {"text": "กดติดตามไว้นะครับ", "start": 36.74, "end": 37.82}]