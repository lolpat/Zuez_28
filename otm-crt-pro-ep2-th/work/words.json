[
{
"text": "การกวาดบอกว่าที่ไหน",
"start": 0,
"end": 1.59
},
{
"text": "การเปลี่ยนโครงสร้างบอกว่าเมื่อไหร่",
"start": 1.73,
"end": 3.9
},
{
"text": "หลังกวาด",
"start": 4.24,
"end": 5.06
},
{
"text": "รอการเปลี่ยนโครงสร้างตลาด",
"start": 5.17,
"end": 6.93
},
{
"text": "คือเนื้อเทียนปิดเลยโลเวอร์ไฮล่าสุด",
"start": 7.02,
"end": 9.67
},
{
"text": "การเคลื่อนไหวนั้นจะทิ้งแฟร์แวลูแก๊ป",
"start": 9.66,
"end": 12.18
},
{
"text": "คือช่องว่างของแท่งเทียนสามแท่ง",
"start": 12.28,
"end": 14.15
},
{
"text": "จุดเข้าคือห้าสิบเปอร์เซ็นต์ของแก๊ป",
"start": 14.44,
"end": 16.6
},
{
"text": "เรียกว่า",
"start": 16.67,
"end": 17.31
},
{
"text": "ซี",
"start": 17.46,
"end": 17.58
},
{
"text": "อี",
"start": 17.73,
"end": 17.85
},
{
"text": "บนทองคำ",
"start": 19.05,
"end": 19.55
},
{
"text": "กรอบสี่ชั่วโมง",
"start": 19.6,
"end": 20.14
},
{
"text": "และกวาดโลว์บนห้านาที",
"start": 20.28,
"end": 21.76
},
{
"text": "จากนั้นเปลี่ยนโครงสร้างขึ้น",
"start": 22.22,
"end": 23.91
},
{
"text": "แล้วตั้งลิมิตที่กลางแก๊ป",
"start": 24.1,
"end": 25.72
},
{
"text": "ตอนต่อไป",
"start": 25.76,
"end": 26.5
},
{
"text": "สต็อปลอส",
"start": 26.56,
"end": 27.72
},
{
"text": "และเป้าหมาย",
"start": 27.78,
"end": 28.59
}
]