[{"text": "สต็อปวางตรงไหน", "start": 0.39, "end": 1.11}, {"text": "และทำกำไรที่ไหน", "start": 1.31, "end": 2.58}, {"text": "สต็อปวางเลยไส้ที่กวาด", "start": 2.68, "end": 4.77}, {"text": "ถ้าราคากลับไปเลยจุดนั้น", "start": 5.06, "end": 6.72}, {"text": "แปลว่าการกวาดล้มเหลว", "start": 7.1, "end": 8.66}, {"text": "ออกทันที", "start": 8.83, "end": 9.5}, {"text": "แบ่งกำไรบางส่วนที่ห้าสิบเปอร์เซ็นต์ของกรอบ", "start": 10.16, "end": 12.6}, {"text": "ราคามักชะลอตรงนั้น", "start": 12.9, "end": 14.42}, {"text": "เป้าเต็มคืออีกฝั่งของกรอบ", "start": 14.53, "end": 16.65}, {"text": "ซี", "start": 16.8, "end": 16.92}, {"text": "อาร์", "start": 17.07, "end": 17.72}, {"text": "ที", "start": 17.87, "end": 17.99}, {"text": "ไฮ", "start": 18.14, "end": 18.53}, {"text": "สำหรับฝั่งซื้อ", "start": 18.68, "end": 19.79}, {"text": "ซี", "start": 19.85, "end": 19.97}, {"text": "อาร์", "start": 20.03, "end": 20.51}, {"text": "ที", "start": 20.56, "end": 20.68}, {"text": "โลว์", "start": 20.74, "end": 21.22}, {"text": "สำหรับฝั่งขาย", "start": 21.28, "end": 22.21}, {"text": "บนทองคำ", "start": 22.58, "end": 23.38}, {"text": "แบ่งกำไรที่ห้าสิบเปอร์เซ็นต์", "start": 23.77, "end": 25.73}, {"text": "ราคาแกว่งอยู่พักหนึ่ง", "start": 25.71, "end": 27.31}, {"text": "แล้ววิ่งไปถึงไฮ", "start": 27.37, "end": 28.51}, {"text": "ประมาณสี่เท่าของความเสี่ยง", "start": 28.54, "end": 30.37}, {"text": "ตอนต่อไป", "start": 30.69, "end": 31.42}, {"text": "คู่ไทม์เฟรมที่ถูกต้อง", "start": 31.87, "end": 33.31}]