[{"text": "สตอรี่ไลน์เกิดขึ้นบนสี่ไทม์เฟรม", "start": 0.83, "end": 2.2}, {"text": "เอ็กซ์หนึ่ง", "start": 2.32, "end": 3.91}, {"text": "รายเดือน", "start": 4.03, "end": 4.68}, {"text": "รายสัปดาห์", "start": 5.01, "end": 5.86}, {"text": "หรือรายวัน", "start": 5.94, "end": 6.66}, {"text": "หาระดับสำคัญที่สด", "start": 7.04, "end": 8.41}, {"text": "และการปฏิเสธ", "start": 8.68, "end": 9.74}, {"text": "เอ็กซ์สอง", "start": 9.8, "end": 10.96}, {"text": "เล็กลงหนึ่งขั้น", "start": 11.02, "end": 12.01}, {"text": "หาการเบรก", "start": 12.39, "end": 13.35}, {"text": "และระดับสำคัญสำหรับจุดเข้า", "start": 13.48, "end": 15.33}, {"text": "เอ็กซ์สาม", "start": 15.39, "end": 16.6}, {"text": "ปรับระดับให้แม่นขึ้น", "start": 16.66, "end": 17.88}, {"text": "และสร้างเซ็ตอัพ", "start": 18.07, "end": 19.13}, {"text": "เอ็กซ์สี่", "start": 19.23, "end": 20.22}, {"text": "ใช้หรือไม่ใช้ก็ได้", "start": 20.32, "end": 21.63}, {"text": "เป็นไทม์เฟรมเล็ก", "start": 21.98, "end": 23.02}, {"text": "ไว้เข้าและวางสต็อปให้แคบลง", "start": 23.42, "end": 25.25}, {"text": "แต่ไม่เคยกำหนดทิศทาง", "start": 25.52, "end": 26.9}, {"text": "บนทองคำ", "start": 27.32, "end": 28.12}, {"text": "รายสัปดาห์ปฏิเสธ", "start": 28.63, "end": 30.03}, {"text": "รายวันเบรก", "start": 30.15, "end": 31.08}, {"text": "สี่ชั่วโมงปรับจุดเข้า", "start": 31.18, "end": 32.83}, {"text": "แล้วราคาวิ่งไปหาลิควิดิตี้ด้านล่าง", "start": 33.1, "end": 35.39}, {"text": "ถ้าเอ็กซ์หนึ่ง", "start": 35.74, "end": 36.74}, {"text": "สอง", "start": 36.72, "end": 37.04}, {"text": "และสามเรียงกันครบ", "start": 37.13, "end": 38.29}, {"text": "ตั้งลิมิตออเดอร์ที่ระดับของเอ็กซ์สามได้เลย", "start": 38.7, "end": 41.03}, {"text": "ตอนต่อไป", "start": 41.58, "end": 42.35}, {"text": "ความผิดพลาดที่ดักเทรดเดอร์ส่วนใหญ่", "start": 42.86, "end": 44.86}]