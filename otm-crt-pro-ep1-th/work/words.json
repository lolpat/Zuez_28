[{"text": "ใน", "start": 0.02, "end": 0.27}, {"text": "ซี", "start": 0.32, "end": 0.44}, {"text": "อาร์", "start": 0.49, "end": 0.96}, {"text": "ที", "start": 1.01, "end": 1.13}, {"text": "ทุกอย่างเริ่มที่การกวาด", "start": 1.18, "end": 3.21}, {"text": "แต่ไม่ใช่ทุกไส้เทียน", "start": 3.48, "end": 4.76}, {"text": "แท่งเทียนหนึ่งแท่งบนไทม์เฟรมใหญ่", "start": 5.24, "end": 7.14}, {"text": "กำหนดกรอบ", "start": 7.62, "end": 8.47}, {"text": "คือ", "start": 8.62, "end": 8.92}, {"text": "ซี", "start": 8.94, "end": 9.06}, {"text": "อาร์", "start": 9.08, "end": 9.48}, {"text": "ที", "start": 9.5, "end": 9.62}, {"text": "ไฮ", "start": 9.64, "end": 9.9}, {"text": "และ", "start": 9.93, "end": 10.17}, {"text": "ซี", "start": 10.18, "end": 10.3}, {"text": "อาร์", "start": 10.31, "end": 10.68}, {"text": "ที", "start": 10.69, "end": 10.81}, {"text": "โลว์", "start": 10.82, "end": 11.2}, {"text": "สต็อปลอสรออยู่ทั้งสองฝั่ง", "start": 11.21, "end": 13.21}, {"text": "บายไซด์ลิควิดิตี้ด้านบน", "start": 13.5, "end": 15.01}, {"text": "เซลไซด์ด้านล่าง", "start": 15.06, "end": 16.41}, {"text": "การกวาดจะใช้ได้", "start": 16.7, "end": 17.86}, {"text": "ก็ต่อเมื่อแท่งไทม์เฟรมเล็ก", "start": 18.13, "end": 19.73}, {"text": "วิ่งเลยระดับ", "start": 19.86, "end": 20.72}, {"text": "แล้วปิดกลับเข้ามาในกรอบ", "start": 20.92, "end": 22.49}, {"text": "ถ้าปิดนอกกรอบ", "start": 22.72, "end": 23.8}, {"text": "แปลว่าราคายอมรับระดับใหม่", "start": 23.98, "end": 25.74}, {"text": "ไม่ใช่การกวาด", "start": 25.96, "end": 26.92}, {"text": "และถ้าไม่มีฝั่งไหนโดนกวาด", "start": 27.08, "end": 28.79}, {"text": "ก็ไม่มีเทรด", "start": 28.82, "end": 29.93}, {"text": "บนทองคำ", "start": 30.0, "end": 30.77}, {"text": "แท่งปิดใต้โลว์", "start": 31.23, "end": 32.34}, {"text": "แล้วร่วงต่อ", "start": 32.36, "end": 33.39}, {"text": "วันต่อมา", "start": 33.56, "end": 34.2}, {"text": "ไส้เทียนกวาดโลว์", "start": 34.38, "end": 35.91}, {"text": "แล้วปิดกลับเข้ามาในกรอบ", "start": 35.94, "end": 37.39}, {"text": "ตัวนี้เทรดได้", "start": 37.45, "end": 38.39}, {"text": "ตอนต่อไป", "start": 38.92, "end": 39.58}, {"text": "จุดเข้า", "start": 39.97, "end": 40.56}]