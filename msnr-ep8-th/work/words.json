[{"text": "ทุกระดับมีสถานะ", "start": 0, "end": 1.59}, {"text": "สด", "start": 1.93, "end": 2.23}, {"text": "หรือไม่สด", "start": 2.24, "end": 3.06}, {"text": "ระดับจะยังสด", "start": 3.3, "end": 4.48}, {"text": "จนกว่าราคาจะมาแตะ", "start": 4.76, "end": 6.29}, {"text": "และยังมีแรงเต็มที่", "start": 6.38, "end": 7.55}, {"text": "ไส้เทียนแตะ", "start": 7.77, "end": 9.23}, {"text": "ทำให้ระดับไม่สด", "start": 9.32, "end": 10.51}, {"text": "ถูกใช้ไปแล้วหนึ่งครั้ง", "start": 10.63, "end": 12.09}, {"text": "และอ่อนลง", "start": 12.08, "end": 13.1}, {"text": "เนื้อเทียนเบรกผ่าน", "start": 13.42, "end": 14.82}, {"text": "ทำให้ระดับกลับมาสดอีกครั้ง", "start": 14.85, "end": 16.78}, {"text": "เริ่มนับใหม่", "start": 16.78, "end": 17.92}, {"text": "และหนึ่งระดับใช้ได้แค่สองครั้ง", "start": 17.95, "end": 20.11}, {"text": "หลังจากนั้นถือว่าจบ", "start": 20.22, "end": 21.71}, {"text": "เช็กสถานะก่อนเสมอ", "start": 21.83, "end": 23.31}, {"text": "ก่อนวางแผนเทรดจากระดับนั้น", "start": 23.54, "end": 25.48}, {"text": "ตอนต่อไป", "start": 25.7, "end": 26.48}, {"text": "การปฏิเสธ", "start": 26.68, "end": 27.88}, {"text": "และการเบรก", "start": 27.94, "end": 28.77}]