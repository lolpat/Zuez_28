[{"text": "คลาสสิก", "start": 0, "end": 0.62}, {"text": "วี", "start": 1.09, "end": 1.21}, {"text": "คือแนวรับ", "start": 1.82, "end": 2.57}, {"text": "ราคาร่วงแรง", "start": 2.98, "end": 3.97}, {"text": "กวาดลิควิดิตี้ด้านล่าง", "start": 4.08, "end": 5.58}, {"text": "แล้วดีดกลับขึ้นเร็วพอกัน", "start": 5.78, "end": 7.48}, {"text": "เกิดเป็นรูปตัววี", "start": 7.51, "end": 8.65}, {"text": "การปฏิเสธที่แรงแบบนี้", "start": 9.22, "end": 10.69}, {"text": "แสดงว่าฝั่งซื้อเข้ามาอย่างดุดันที่จุดต่ำสุด", "start": 10.87, "end": 14.01}, {"text": "วิธีวาด", "start": 14.34, "end": 15.34}, {"text": "มาร์คราคาปิดของแท่งขาลงแท่งสุดท้าย", "start": 15.48, "end": 17.96}, {"text": "และราคาเปิดของแท่งขาขึ้นแท่งแรกหลังจากนั้น", "start": 18.36, "end": 21.22}, {"text": "ตัวอย่างบนทองคำ", "start": 21.56, "end": 22.74}, {"text": "ราคากวาดลิควิดิตี้ใต้โลว์", "start": 23.26, "end": 25.29}, {"text": "แตะระดับคลาสสิก", "start": 25.4, "end": 26.56}, {"text": "วี", "start": 26.91, "end": 27.03}, {"text": "เด้งตอบสนอง", "start": 27.27, "end": 28.5}, {"text": "แล้ววิ่งขึ้นไปเก็บบายไซด์ลิควิดิตี้", "start": 28.84, "end": 30.74}, {"text": "ระดับสำคัญ", "start": 31.22, "end": 32.09}, {"text": "การตอบสนอง", "start": 32.21, "end": 33.26}, {"text": "เป้าหมาย", "start": 33.33, "end": 34.15}, {"text": "ตอนต่อไป", "start": 34.52, "end": 35.18}, {"text": "คลาสสิก", "start": 35.61, "end": 36.2}, {"text": "เอ", "start": 36.37, "end": 36.55}]