[{"text": "คลาสสิก", "start": 0, "end": 0.58}, {"text": "วี", "start": 1.01, "end": 1.13}, {"text": "คือแนวรับ", "start": 1.73, "end": 2.46}, {"text": "ราคาร่วงแรง", "start": 2.89, "end": 3.88}, {"text": "กวาดลิควิดิตี้ด้านล่าง", "start": 4.07, "end": 5.63}, {"text": "แล้วดีดกลับขึ้นเร็วพอกัน", "start": 5.93, "end": 7.64}, {"text": "เกิดเป็นรูปตัววี", "start": 7.9, "end": 8.8}, {"text": "การปฏิเสธที่แรงแบบนี้", "start": 9.46, "end": 10.98}, {"text": "แสดงว่าฝั่งซื้อเข้ามาอย่างดุดันที่จุดต่ำสุด", "start": 11.46, "end": 14.44}, {"text": "วิธีวาด", "start": 14.86, "end": 15.84}, {"text": "เปลี่ยนเป็นกราฟเส้น", "start": 15.96, "end": 17.0}, {"text": "แล้วมาร์คจุดต่ำสุดของตัววี", "start": 17.37, "end": 19.04}, {"text": "จากนั้นกลับมาที่กราฟแท่งเทียน", "start": 19.7, "end": 21.81}, {"text": "แล้ววางสต็อปลอสใต้ไส้เทียน", "start": 22.14, "end": 24.02}, {"text": "ตัวอย่างบนทองคำ", "start": 24.36, "end": 25.58}, {"text": "ราคากวาดลิควิดิตี้ใต้โลว์", "start": 26.15, "end": 28.24}, {"text": "แตะระดับคลาสสิก", "start": 28.38, "end": 29.57}, {"text": "วี", "start": 29.86, "end": 29.98}, {"text": "เด้งตอบสนอง", "start": 30.28, "end": 31.51}, {"text": "แล้ววิ่งขึ้นไปเก็บบายไซด์ลิควิดิตี้", "start": 31.86, "end": 33.82}, {"text": "ระดับสำคัญ", "start": 34.29, "end": 35.22}, {"text": "การตอบสนอง", "start": 35.38, "end": 36.47}, {"text": "เป้าหมาย", "start": 36.78, "end": 37.38}, {"text": "ตอนต่อไป", "start": 37.74, "end": 38.44}, {"text": "คลาสสิก", "start": 38.9, "end": 39.46}, {"text": "เอ", "start": 39.34, "end": 39.46}]