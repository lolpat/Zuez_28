[{"text": "เทรนด์ไลน์ไม่เคยเป็นจุดเข้าด้วยตัวเอง", "start": 0.87, "end": 2.6}, {"text": "มันคือการยืนยัน", "start": 2.96, "end": 4.15}, {"text": "ที่ระดับสำคัญ", "start": 4.28, "end": 5.45}, {"text": "สวิงแรก", "start": 5.9, "end": 6.69}, {"text": "มีแท่งกลืนกิน", "start": 6.94, "end": 7.9}, {"text": "สวิงที่สอง", "start": 8.3, "end": 9.17}, {"text": "มีแท่งกลืนกินอีกครั้ง", "start": 9.43, "end": 10.73}, {"text": "และเบรกโครงสร้าง", "start": 11.06, "end": 12.31}, {"text": "ลากเส้นเชื่อมสองสวิง", "start": 12.64, "end": 14.12}, {"text": "การแตะครั้งที่สาม", "start": 14.44, "end": 15.76}, {"text": "คือจุดเข้า", "start": 15.8, "end": 16.67}, {"text": "ถ้าเส้นโดนเบรก", "start": 17.06, "end": 18.21}, {"text": "อย่าลบทิ้ง", "start": 18.22, "end": 18.92}, {"text": "การรีเทสต์จากอีกฝั่ง", "start": 19.24, "end": 20.67}, {"text": "ก็เทรดได้เหมือนกัน", "start": 20.69, "end": 21.87}, {"text": "และถ้าสวิงอยู่ในแนวราบ", "start": 22.16, "end": 23.74}, {"text": "ให้ลากจากเนื้อเทียนถึงเนื้อเทียน", "start": 23.74, "end": 25.78}, {"text": "ไม่ใช่จากไส้ถึงไส้", "start": 25.96, "end": 27.29}, {"text": "ระดับที่แข็งแรง", "start": 27.84, "end": 28.89}, {"text": "สต็อปที่แคบ", "start": 28.93, "end": 30.1}, {"text": "เฟรชฟลิป", "start": 30.16, "end": 31.38}, {"text": "ระดับเดียวที่รีไฟน์แล้ว", "start": 31.44, "end": 33.1}, {"text": "เรื่องราวที่ชัดเจน", "start": 33.19, "end": 34.56}, {"text": "และจุดเข้าที่ยืนยันแล้ว", "start": 34.76, "end": 36.54}, {"text": "Order", "start": 36.86, "end": 37.23}, {"text": "the", "start": 37.17, "end": 37.41}, {"text": "market...", "start": 37.35, "end": 37.81}, {"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ", "start": 38.3, "end": 40.12}, {"text": "กดติดตามไว้นะครับ", "start": 40.44, "end": 41.49}]