[{"text": "ห้าตอนสั้นๆ", "start": 0.25, "end": 1.22}, {"text": "เทรด", "start": 1.61, "end": 1.99}, {"text": "ซี", "start": 2.02, "end": 2.14}, {"text": "อาร์", "start": 2.18, "end": 2.61}, {"text": "ที", "start": 2.64, "end": 2.76}, {"text": "ด้วยกฎ", "start": 2.8, "end": 3.44}, {"text": "ไม่ใช่การเดา", "start": 3.6, "end": 4.4}, {"text": "แยกการกวาดที่ใช้ได้", "start": 4.86, "end": 6.24}, {"text": "ออกจากการกวาดหลอก", "start": 6.71, "end": 7.98}, {"text": "เข้าออเดอร์ตอนเปลี่ยนโครงสร้าง", "start": 7.99, "end": 9.94}, {"text": "ที่แฟร์แวลูแก๊ป", "start": 10.13, "end": 11.39}, {"text": "วางสต็อป", "start": 11.46, "end": 12.25}, {"text": "และแบ่งกำไรที่ห้าสิบเปอร์เซ็นต์", "start": 12.44, "end": 14.32}, {"text": "เลือกคู่ไทม์เฟรมให้ถูก", "start": 14.29, "end": 16.03}, {"text": "และไล่เช็กลิสต์เดียว", "start": 16.16, "end": 17.49}, {"text": "ก่อนเทรดทุกครั้ง", "start": 17.55, "end": 18.65}, {"text": "เซฟซีรีส์นี้ไว้", "start": 18.7, "end": 20.05}, {"text": "แล้วเริ่มที่ตอนที่หนึ่ง", "start": 20.56, "end": 21.38}]