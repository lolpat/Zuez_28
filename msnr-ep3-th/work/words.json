[{"text": "เอส", "start": 1.4, "end": 1.54}, {"text": "บี", "start": 1.42, "end": 1.54}, {"text": "อาร์", "start": 1.43, "end": 1.56}, {"text": "แนวรับกลายเป็นแนวต้าน", "start": 1.45, "end": 2.86}, {"text": "แนวรับถูกเบรกลง", "start": 3.04, "end": 4.49}, {"text": "แล้วสลับบทบาท", "start": 4.78, "end": 5.86}, {"text": "เมื่อราคากลับขึ้นมาทดสอบจากด้านล่าง", "start": 6.15, "end": 8.44}, {"text": "พื้นเดิมกลายเป็นเพดาน", "start": 8.9, "end": 10.53}, {"text": "และฝั่งขายจะเข้ามาป้องกัน", "start": 10.66, "end": 12.53}, {"text": "วิธีวาด", "start": 12.98, "end": 14.0}, {"text": "หาแนวรับที่ราคาเด้งมากกว่าหนึ่งครั้ง", "start": 14.16, "end": 16.51}, {"text": "รอแท่งขาลงที่แรง", "start": 16.94, "end": 18.3}, {"text": "ปิดใต้แนวนั้น", "start": 18.46, "end": 19.76}, {"text": "แล้วมาร์คราคาเปิดของแท่งที่เบรก", "start": 19.88, "end": 22.22}, {"text": "ตัวอย่างบนทองคำ", "start": 22.36, "end": 23.49}, {"text": "แนวรับแตก", "start": 23.94, "end": 24.82}, {"text": "เกิดเซลไซด์ลิควิดิตี้ด้านล่าง", "start": 24.89, "end": 26.98}, {"text": "ราคาดีดกลับมาที่", "start": 27.34, "end": 28.45}, {"text": "เอส", "start": 28.47, "end": 28.88}, {"text": "บี", "start": 28.9, "end": 29.02}, {"text": "อาร์", "start": 29.05, "end": 29.46}, {"text": "โดนปฏิเสธ", "start": 29.48, "end": 30.48}, {"text": "แล้วร่วงลงไปเก็บลิควิดิตี้นั้น", "start": 30.57, "end": 32.64}, {"text": "เบรก", "start": 32.79, "end": 33.42}, {"text": "ทดสอบ", "start": 33.56, "end": 34.22}, {"text": "ปฏิเสธ", "start": 34.48, "end": 35.08}, {"text": "เป้าหมาย", "start": 35.09, "end": 35.96}, {"text": "ตอนต่อไป", "start": 36.07, "end": 36.92}, {"text": "แนวต้านกลายเป็นแนวรับ", "start": 37.44, "end": 38.94}]