[{"text": "ไส้เทียนไม่ใช่สัญญาณ", "start": 0.11, "end": 1.59}, {"text": "ราคาปิดต่างหาก", "start": 2.06, "end": 3.15}, {"text": "คือสัญญาณ", "start": 3.2, "end": 4.11}, {"text": "นี่คือกรอบสี่ชั่วโมง", "start": 4.6, "end": 5.93}, {"text": "ที่มาร์คโลว์ของกรอบไว้", "start": 5.9, "end": 7.51}, {"text": "ราคาหลุดลงไปใต้โลว์", "start": 8.05, "end": 9.92}, {"text": "จากนี้", "start": 10.1, "end": 10.55}, {"text": "เป็นไปได้สองแบบ", "start": 11.08, "end": 12.18}, {"text": "แบบเอ", "start": 12.39, "end": 13.26}, {"text": "แท่งเทียนปิดกลับเข้ามาในกรอบ", "start": 13.2, "end": 15.19}, {"text": "นี่คือการกวาดของจริง", "start": 15.29, "end": 16.83}, {"text": "สต็อปโดนเก็บไปแล้ว", "start": 16.91, "end": 18.58}, {"text": "และราคากลับเข้ากล่อง", "start": 18.89, "end": 20.22}, {"text": "แบบบี", "start": 20.62, "end": 21.01}, {"text": "แท่งเทียนปิดใต้โลว์", "start": 21.0, "end": 23.14}, {"text": "นี่ไม่ใช่การกวาด", "start": 23.3, "end": 24.47}, {"text": "แต่คือราคายอมรับระดับที่ต่ำลง", "start": 24.83, "end": 26.93}, {"text": "ถ้าเข้าซื้อตรงนี้", "start": 27.36, "end": 28.27}, {"text": "สต็อปของคุณจะโดนแทน", "start": 28.82, "end": 30.19}, {"text": "แล้วถ้าราคาไม่แตะทั้งสองฝั่งล่ะ", "start": 30.51, "end": 32.52}, {"text": "ไม่มีการกวาด", "start": 32.83, "end": 33.87}, {"text": "ก็ไม่มีเทรด", "start": 33.95, "end": 34.83}, {"text": "รอแท่งถัดไป", "start": 35.17, "end": 36.06}, {"text": "กฎจึงง่ายมาก", "start": 36.42, "end": 37.7}, {"text": "ไม่ปิดกลับเข้ากรอบ", "start": 37.93, "end": 39.2}, {"text": "ก็ไม่ใช่ซีอาร์ที", "start": 39.24, "end": 40.74}, {"text": "ตอนต่อไป", "start": 40.82, "end": 41.58}, {"text": "จุดเข้า", "start": 42.05, "end": 42.65}, {"text": "จุดสต็อป", "start": 42.93, "end": 43.57}, {"text": "และเป้าหมาย", "start": 43.61, "end": 44.38}, {"text": "Order", "start": 44.81, "end": 45.23}, {"text": "the", "start": 45.17, "end": 45.41}, {"text": "market...", "start": 45.36, "end": 45.82}, {"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ", "start": 46.46, "end": 48.15}, {"text": "กดติดตามไว้นะครับ", "start": 48.34, "end": 49.56}]