[{"text": "คลาสสิก", "start": 0, "end": 0.61}, {"text": "เอ", "start": 0.94, "end": 1.51}, {"text": "คือแนวต้าน", "start": 1.84, "end": 2.97}, {"text": "ราคาพุ่งขึ้นเป็นยอดแหลม", "start": 3.21, "end": 4.81}, {"text": "แล้วกลับลงเร็วพอกัน", "start": 5.11, "end": 6.5}, {"text": "เกิดเป็นรูปตัวเอ", "start": 6.82, "end": 8.08}, {"text": "ตรงนั้น", "start": 8.15, "end": 8.73}, {"text": "ฝั่งขายเอาชนะฝั่งซื้อได้", "start": 8.94, "end": 10.91}, {"text": "วิธีวาด", "start": 11.61, "end": 12.56}, {"text": "มาร์คราคาปิดของแท่งขาขึ้นแท่งสุดท้าย", "start": 12.68, "end": 15.3}, {"text": "และราคาเปิดของแท่งขาลงแท่งแรก", "start": 15.7, "end": 17.92}, {"text": "แล้วลากเส้นไปทางขวา", "start": 18.23, "end": 19.78}, {"text": "ตัวอย่างบนทองคำ", "start": 20.05, "end": 21.48}, {"text": "ราคากวาดจุดล่อด้านบน", "start": 21.98, "end": 23.57}, {"text": "แตะระดับคลาสสิก", "start": 23.92, "end": 25.14}, {"text": "เอ", "start": 25.32, "end": 25.73}, {"text": "เปลี่ยนโครงสร้างลง", "start": 25.91, "end": 27.06}, {"text": "แล้ววิ่งไปเก็บเซลไซด์ลิควิดิตี้", "start": 27.38, "end": 29.15}, {"text": "กวาด", "start": 29.84, "end": 30.23}, {"text": "ระดับสำคัญ", "start": 30.4, "end": 31.29}, {"text": "กลับตัว", "start": 31.41, "end": 32.22}, {"text": "เป้าหมาย", "start": 32.47, "end": 33.22}, {"text": "ตอนต่อไป", "start": 33.46, "end": 34.18}, {"text": "แนวรับกลายเป็นแนวต้าน", "start": 34.43, "end": 36.16}]