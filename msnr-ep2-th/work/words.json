[{"text": "คลาสสิก", "start": 0, "end": 0.62}, {"text": "เอ", "start": 0.92, "end": 1.47}, {"text": "คือแนวต้าน", "start": 1.77, "end": 2.62}, {"text": "ราคาพุ่งขึ้นเป็นยอดแหลม", "start": 3.05, "end": 4.58}, {"text": "แล้วกลับลงเร็วพอกัน", "start": 4.89, "end": 6.37}, {"text": "เกิดเป็นรูปตัวเอ", "start": 6.63, "end": 7.83}, {"text": "ตรงนั้น", "start": 7.88, "end": 8.57}, {"text": "ฝั่งขายเอาชนะฝั่งซื้อได้", "start": 8.75, "end": 10.73}, {"text": "วิธีวาด", "start": 11.4, "end": 12.26}, {"text": "เปลี่ยนเป็นกราฟเส้น", "start": 12.35, "end": 13.45}, {"text": "แล้วมาร์คจุดสูงสุดของตัวเอ", "start": 13.78, "end": 15.67}, {"text": "จากนั้นกลับมาที่กราฟแท่งเทียน", "start": 15.7, "end": 18.0}, {"text": "แล้ววางสต็อปลอสเหนือไส้เทียน", "start": 18.35, "end": 20.42}, {"text": "ตัวอย่างบนทองคำ", "start": 20.72, "end": 21.86}, {"text": "ราคากวาดจุดล่อด้านบน", "start": 22.39, "end": 23.96}, {"text": "แตะระดับคลาสสิก", "start": 24.4, "end": 25.56}, {"text": "เอ", "start": 25.8, "end": 26.28}, {"text": "เปลี่ยนโครงสร้างลง", "start": 26.52, "end": 27.61}, {"text": "แล้ววิ่งไปเก็บเซลไซด์ลิควิดิตี้", "start": 27.96, "end": 29.73}, {"text": "กวาด", "start": 30.28, "end": 30.8}, {"text": "ระดับสำคัญ", "start": 31.02, "end": 31.88}, {"text": "กลับตัว", "start": 32.22, "end": 32.84}, {"text": "เป้าหมาย", "start": 32.96, "end": 33.82}, {"text": "ตอนต่อไป", "start": 34.06, "end": 34.78}, {"text": "แนวรับกลายเป็นแนวต้าน", "start": 35.29, "end": 36.77}]