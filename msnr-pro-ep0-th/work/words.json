[
{
"text": "เจ็ดตอนสั้นๆ",
"start": 0,
"end": 1.12
},
{
"text": "ดูจบแล้ว",
"start": 1.36,
"end": 2.29
},
{
"text": "คุณจะทำสิ่งเหล่านี้ได้",
"start": 2.42,
"end": 3.77
},
{
"text": "แยกคลาสสิก",
"start": 4.7,
"end": 5.5
},
{
"text": "เอ",
"start": 5.61,
"end": 5.96
},
{
"text": "และ",
"start": 6.07,
"end": 6.27
},
{
"text": "วี",
"start": 6.49,
"end": 6.61
},
{
"text": "ตัวที่แข็งแรง",
"start": 6.83,
"end": 7.82
},
{
"text": "ออกจากตัวที่อ่อน",
"start": 8.15,
"end": 9.26
},
{
"text": "ลดสต็อปลงครึ่งหนึ่ง",
"start": 9.62,
"end": 11.14
},
{
"text": "ด้วยไส้เทียนห้าสิบเปอร์เซ็นต์",
"start": 11.21,
"end": 13.08
},
{
"text": "รู้ว่าระดับที่โดนเบรก",
"start": 13.06,
"end": 14.66
},
{
"text": "เมื่อไหร่ยังสดอยู่",
"start": 14.7,
"end": 15.89
},
{
"text": "รีไฟน์กราฟที่รก",
"start": 16.46,
"end": 17.69
},
{
"text": "ให้เหลือระดับเดียว",
"start": 17.71,
"end": 19.16
},
{
"text": "อ่านสตอรี่ไลน์",
"start": 19.19,
"end": 20.61
},
{
"text": "จากระดับสำคัญหนึ่ง",
"start": 20.64,
"end": 21.94
},
{
"text": "ไปอีกระดับหนึ่ง",
"start": 22.1,
"end": 23.27
},
{
"text": "เข้าออเดอร์ด้วยโมเดลที่ชัดเจน",
"start": 23.37,
"end": 25.36
},
{
"text": "ลงไปสองไทม์เฟรม",
"start": 25.62,
"end": 26.9
},
{
"text": "และยืนยันด้วยเทรนด์ไลน์",
"start": 27.18,
"end": 28.91
},
{
"text": "เซฟซีรีส์นี้ไว้",
"start": 28.97,
"end": 30.49
},
{
"text": "แล้วเริ่มที่ตอนที่หนึ่ง",
"start": 30.54,
"end": 31.81
}
]