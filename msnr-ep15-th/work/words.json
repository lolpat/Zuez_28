[{"text": "เมื่อบนเอ็กซ์สาม", "start": 0, "end": 1.18}, {"text": "มีระดับสำคัญที่ยังสดมากกว่าหนึ่งระดับ", "start": 1.17, "end": 3.92}, {"text": "เรามีสองทางเลือก", "start": 4.11, "end": 5.34}, {"text": "รอการยืนยันบนเอ็กซ์สี่", "start": 5.78, "end": 7.52}, {"text": "ที่ระดับไหนก็ได้", "start": 7.54, "end": 8.65}, {"text": "หรือตั้งลิมิตไว้ที่เอเพ็กซ์เลย", "start": 9.18, "end": 10.99}, {"text": "จะเลือกระดับไหน", "start": 11.39, "end": 12.4}, {"text": "ให้เช็กว่าระดับไหนยังสด", "start": 12.68, "end": 14.32}, {"text": "แล้วทำตามลำดับความสำคัญ", "start": 14.53, "end": 16.23}, {"text": "ควอซิโมโดมาก่อน", "start": 16.56, "end": 17.88}, {"text": "ตามด้วยเอเพ็กซ์", "start": 17.98, "end": 19.24}, {"text": "คือคลาสสิกวี", "start": 19.24, "end": 20.6}, {"text": "หรือเอ", "start": 20.63, "end": 21.38}, {"text": "แล้วจึงเป็นเอสบีอาร์", "start": 21.52, "end": 23.14}, {"text": "อาร์บีเอส", "start": 23.16, "end": 24.09}, {"text": "และโอซีแอล", "start": 24.1, "end": 25.05}, {"text": "ซึ่งเท่ากัน", "start": 25.05, "end": 25.91}, {"text": "บนทองคำ", "start": 26.22, "end": 26.98}, {"text": "คิวเอ็มถูกใช้ไปแล้ว", "start": 27.02, "end": 28.77}, {"text": "เราจึงตัดทิ้ง", "start": 28.77, "end": 29.82}, {"text": "ราคากลับมาที่อาร์บีเอสที่ยังสด", "start": 30.18, "end": 32.25}, {"text": "เปลี่ยนโครงสร้าง", "start": 32.44, "end": 33.49}, {"text": "และนั่นคือจุดเข้า", "start": 33.82, "end": 35.0}, {"text": "ข้ามการยืนยันไป", "start": 35.18, "end": 36.44}, {"text": "อาจพลาดบางรอบ", "start": 36.85, "end": 37.9}, {"text": "แต่เรารักษาพอร์ตไว้ได้", "start": 38.13, "end": 39.46}, {"text": "สำหรับเทรดถัดไป", "start": 39.94, "end": 41.0}, {"text": "Order", "start": 41.44, "end": 41.81}, {"text": "the", "start": 41.74, "end": 41.96}, {"text": "market...", "start": 41.89, "end": 42.31}, {"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ", "start": 42.78, "end": 44.45}, {"text": "กดติดตามไว้นะครับ", "start": 44.74, "end": 45.83}]