[{"text": "อาร์", "start": 1.29, "end": 1.42}, {"text": "บี", "start": 1.31, "end": 1.43}, {"text": "เอส", "start": 1.32, "end": 1.46}, {"text": "แนวต้านกลายเป็นแนวรับ", "start": 1.35, "end": 2.71}, {"text": "แนวต้านถูกเบรกขึ้น", "start": 2.81, "end": 4.38}, {"text": "แล้วสลับบทบาท", "start": 4.61, "end": 5.71}, {"text": "เมื่อราคากลับมาทดสอบ", "start": 5.99, "end": 7.61}, {"text": "ระดับที่เคยกดราคาไว้", "start": 7.86, "end": 9.34}, {"text": "ตอนนี้กลับรับราคาไว้", "start": 9.73, "end": 11.26}, {"text": "และฝั่งซื้อจะเข้ามาป้องกัน", "start": 11.64, "end": 13.43}, {"text": "วิธีวาด", "start": 13.86, "end": 14.87}, {"text": "หาแนวต้านที่ราคาโดนปฏิเสธมากกว่าหนึ่งครั้ง", "start": 15.02, "end": 17.91}, {"text": "รอแท่งขาขึ้นที่แรง", "start": 18.37, "end": 19.7}, {"text": "ปิดเหนือแนวนั้น", "start": 19.85, "end": 21.05}, {"text": "แล้วมาร์คราคาเปิดของแท่งที่เบรก", "start": 21.22, "end": 23.6}, {"text": "ตัวอย่างบนทองคำ", "start": 23.64, "end": 24.76}, {"text": "แนวต้านแตก", "start": 25.26, "end": 26.25}, {"text": "ราคากลับมาทดสอบ", "start": 26.55, "end": 27.88}, {"text": "อาร์", "start": 27.88, "end": 28.23}, {"text": "บี", "start": 28.23, "end": 28.35}, {"text": "เอส", "start": 28.35, "end": 28.7}, {"text": "สะสมตัวบนระดับนั้น", "start": 28.7, "end": 30.36}, {"text": "แล้วดันขึ้นไปเก็บบายไซด์ลิควิดิตี้", "start": 30.52, "end": 33.36}, {"text": "เบรก", "start": 33.39, "end": 33.98}, {"text": "ทดสอบ", "start": 34.01, "end": 34.65}, {"text": "สะสม", "start": 34.85, "end": 35.36}, {"text": "เป้าหมาย", "start": 35.82, "end": 36.4}, {"text": "ตอนต่อไป", "start": 36.75, "end": 37.4}, {"text": "ระดับราคาเปิดปิด", "start": 37.81, "end": 39.05}]