[
{
"text": "เทรดเดอร์ส่วนใหญ่",
"start": 0.5,
"end": 1.3
},
{
"text": "มัวแต่ตามหาไม้ที่ชนะ",
"start": 1.48,
"end": 2.96
},
{
"text": "แต่คนที่อยู่รอด",
"start": 3.58,
"end": 4.78
},
{
"text": "กำลังสร้างระบบที่ชนะ",
"start": 4.78,
"end": 6.42
},
{
"text": "ลองถามเทรดเดอร์ที่ยังขาดทุน",
"start": 7.04,
"end": 8.9
},
{
"text": "ถึงร้อยไม้ล่าสุดของเขา",
"start": 9.14,
"end": 11.08
},
{
"text": "เขาตอบไม่ได้ด้วยซ้ำ",
"start": 11.08,
"end": 12.5
},
{
"text": "ว่ากลยุทธ์ตัวเองทำเงินหรือเปล่า",
"start": 12.76,
"end": 14.7
},
{
"text": "คุณบริหารธุรกิจด้วยการเดาไม่ได้",
"start": 15.36,
"end": 18.0
},
{
"text": "ดังนั้น",
"start": 18.0,
"end": 18.5
},
{
"text": "รู้ตัวเลขสามตัว",
"start": 18.86,
"end": 20.12
},
{
"text": "อัตราชนะ",
"start": 20.5,
"end": 21.2
},
{
"text": "กำไรเฉลี่ย",
"start": 21.2,
"end": 22.5
},
{
"text": "ขาดทุนเฉลี่ย",
"start": 22.74,
"end": 23.58
},
{
"text": "สมมติว่าคุณชนะสี่สิบเปอร์เซ็นต์",
"start": 24.06,
"end": 26.36
},
{
"text": "กำไรเฉลี่ยสองอาร์",
"start": 25.82,
"end": 28.0
},
{
"text": "ขาดทุนเฉลี่ยหนึ่งอาร์",
"start": 27.92,
"end": 29.54
},
{
"text": "สี่สิบคูณสอง",
"start": 29.06,
"end": 31.26
},
{
"text": "ลบหกสิบคูณหนึ่ง",
"start": 31.22,
"end": 32.82
},
{
"text": "ได้บวกยี่สิบอาร์",
"start": 32.64,
"end": 34.48
},
{
"text": "ในหนึ่งร้อยไม้",
"start": 34.22,
"end": 35.48
},
{
"text": "คุณแพ้บ่อยกว่า",
"start": 35.48,
"end": 36.7
},
{
"text": "แต่ยังทำเงินได้",
"start": 37.0,
"end": 38.38
},
{
"text": "เลิกถามว่า",
"start": 38.38,
"end": 39.5
},
{
"text": "ไม้ต่อไปจะชนะไหม",
"start": 39.7,
"end": 40.88
},
{
"text": "เริ่มถามว่า",
"start": 41.44,
"end": 42.5
},
{
"text": "กลยุทธ์ของฉัน",
"start": 42.5,
"end": 43.7
},
{
"text": "ทำเงินได้ไหม",
"start": 43.7,
"end": 44.68
},
{
"text": "ในหนึ่งร้อยไม้",
"start": 45.02,
"end": 46.24
},
{
"text": "ไม้ที่ชนะไม้เดียว",
"start": 46.3,
"end": 47.7
},
{
"text": "ทำให้คุณรู้สึกเหมือนอัจฉริยะ",
"start": 47.84,
"end": 49.44
},
{
"text": "แต่มีแค่ตัวเลข",
"start": 49.44,
"end": 50.84
},
{
"text": "ที่พิสูจน์ได้ว่าคุณมีความได้เปรียบจริง",
"start": 51.22,
"end": 53.74
},
{
"text": "Order",
"start": 53.74,
"end": 54.24
},
{
"text": "the",
"start": 54.24,
"end": 54.4
},
{
"text": "market",
"start": 54.4,
"end": 54.84
},
{
"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ",
"start": 55.58,
"end": 57.4
},
{
"text": "กดติดตามไว้นะครับ",
"start": 57.2,
"end": 58.76
}
