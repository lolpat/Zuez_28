[{"text": "กรอบราคา", "start": 0, "end": 0.82}, {"text": "กับจุดเข้า", "start": 0.97, "end": 1.87}, {"text": "อยู่คนละกราฟกัน", "start": 1.95, "end": 3.31}, {"text": "กรอบสี่ชั่วโมง", "start": 3.86, "end": 4.95}, {"text": "หาจุดเข้าที่กราฟห้านาที", "start": 5.13, "end": 6.79}, {"text": "หรือสิบห้านาที", "start": 7.24, "end": 8.07}, {"text": "กรอบรายวัน", "start": 8.74, "end": 9.63}, {"text": "ลงไปที่หนึ่งชั่วโมง", "start": 9.93, "end": 11.26}, {"text": "ถ้าไทม์เฟรมใกล้กันเกินไป", "start": 11.49, "end": 13.12}, {"text": "การกวาดก็เป็นแค่สัญญาณรบกวน", "start": 13.64, "end": 15.9}, {"text": "ถ้าห่างกันเกินไป", "start": 16.16, "end": 17.29}, {"text": "อาจต้องรอหลายวัน", "start": 17.7, "end": 18.82}, {"text": "กว่าจะเจอสักเซ็ตอัพ", "start": 18.85, "end": 20.47}, {"text": "นี่คือความผิดพลาดที่เจอบ่อย", "start": 20.5, "end": 22.16}, {"text": "เทรดเดอร์ลงไปดูถึงกราฟหนึ่งนาที", "start": 22.16, "end": 24.43}, {"text": "ในกรอบ", "start": 24.94, "end": 25.53}, {"text": "ทุกการย่อตัวเล็กๆ", "start": 25.82, "end": 27.13}, {"text": "ดูเหมือนการกวาดไปหมด", "start": 27.35, "end": 28.72}, {"text": "เข้าซื้อไม้หนึ่ง", "start": 29.01, "end": 30.09}, {"text": "โดนสต็อป", "start": 30.13, "end": 31.2}, {"text": "แล้วก็อีกไม้", "start": 31.24, "end": 31.95}, {"text": "แต่ไม่มีโลว์ไหนเลย", "start": 32.42, "end": 33.63}, {"text": "ที่เป็นโลว์ของกรอบ", "start": 33.82, "end": 34.96}, {"text": "เป็นแค่สวิงเล็กๆ", "start": 35.21, "end": 36.35}, {"text": "ที่แทบไม่มีสต็อปอยู่ข้างใต้", "start": 36.48, "end": 37.96}, {"text": "การกวาดที่สำคัญ", "start": 38.7, "end": 39.9}, {"text": "มีแค่การกวาดโลว์ของกรอบเท่านั้น", "start": 40.03, "end": 42.25}, {"text": "ตอนต่อไป", "start": 42.72, "end": 43.4}, {"text": "เช็กลิสต์ซีอาร์ทีฉบับเต็ม", "start": 44.09, "end": 45.52}, {"text": "Order", "start": 46.0, "end": 46.37}, {"text": "the", "start": 46.3, "end": 46.52}, {"text": "market...", "start": 46.46, "end": 46.94}, {"text": "อย่าให้ตลาดเป็นฝ่ายสั่งคุณ", "start": 47.5, "end": 49.32}, {"text": "กดติดตามไว้นะครับ", "start": 49.49, "end": 50.7}]