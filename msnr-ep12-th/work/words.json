[{"text": "ทุกเทรดมีสองส่วน", "start": 0, "end": 1.42}, {"text": "คือการยืนยัน", "start": 1.72, "end": 2.74}, {"text": "และจุดเข้า", "start": 2.89, "end": 3.78}, {"text": "แยกสองอย่างนี้ออกจากกัน", "start": 3.96, "end": 5.8}, {"text": "แล้วทุกเซ็ตอัพจะจดบันทึก", "start": 6.15, "end": 7.86}, {"text": "และแบ็กเทสต์ได้ง่าย", "start": 7.99, "end": 9.23}, {"text": "การยืนยัน", "start": 9.84, "end": 10.69}, {"text": "คือหลักฐานว่าการเคลื่อนไหวที่เราคาดไว้", "start": 11.0, "end": 13.51}, {"text": "เริ่มขึ้นแล้ว", "start": 13.72, "end": 14.66}, {"text": "มีสามแบบ", "start": 14.87, "end": 15.73}, {"text": "หนึ่ง", "start": 15.81, "end": 16.34}, {"text": "แก๊ปเบรก", "start": 16.42, "end": 17.76}, {"text": "ราคาทะลุแก๊ปที่ระดับ", "start": 17.84, "end": 19.34}, {"text": "และปิดเลยออกไป", "start": 19.45, "end": 20.45}, {"text": "แสดงว่าระดับนั้นได้รับการเคารพ", "start": 20.84, "end": 23.11}, {"text": "สอง", "start": 23.3, "end": 24.03}, {"text": "การเปลี่ยนโครงสร้างตลาด", "start": 24.21, "end": 25.69}, {"text": "ราคาเบรกสวิงล่าสุด", "start": 26.09, "end": 27.54}, {"text": "และทิศทางเปลี่ยน", "start": 27.52, "end": 28.6}, {"text": "สาม", "start": 28.82, "end": 29.6}, {"text": "การเบรกเทรนด์ไลน์", "start": 29.82, "end": 31.21}, {"text": "แท่งเทียนปิดเลยเทรนด์ไลน์", "start": 31.39, "end": 33.14}, {"text": "แรงส่งเดิมหมดลงแล้ว", "start": 33.25, "end": 34.72}, {"text": "แต่การยืนยัน", "start": 35.09, "end": 36.08}, {"text": "จะนับก็ต่อเมื่อเกิดที่ระดับสำคัญที่ยังสด", "start": 36.12, "end": 39.01}, {"text": "ที่อื่นเป็นแค่สัญญาณรบกวน", "start": 39.44, "end": 41.22}, {"text": "ตอนต่อไป", "start": 41.8, "end": 42.52}, {"text": "ตัวอย่างเต็ม", "start": 42.67, "end": 43.59}, {"text": "ตั้งแต่สตอรี่ไลน์", "start": 43.74, "end": 45.16}, {"text": "จนถึงจุดเข้า", "start": 45.17, "end": 46.11}]