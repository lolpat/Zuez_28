[{"text": "กรอบถูก", "start": 0, "end": 0.79}, {"text": "แต่ไทม์เฟรมผิด", "start": 0.93, "end": 1.94}, {"text": "ก็ยังขาดทุน", "start": 2.07, "end": 3.13}, {"text": "กรอบสี่ชั่วโมง", "start": 3.68, "end": 4.89}, {"text": "เข้าบนห้านาที", "start": 4.91, "end": 6.0}, {"text": "หรือสิบห้านาที", "start": 5.97, "end": 7.72}, {"text": "กรอบรายวัน", "start": 7.9, "end": 8.78}, {"text": "เข้าบนหนึ่งชั่วโมง", "start": 8.82, "end": 10.63}, {"text": "ถ้าลงไปเล็กเกินไป", "start": 10.7, "end": 11.95}, {"text": "เช่นกรอบสี่ชั่วโมงบนหนึ่งนาที", "start": 12.04, "end": 14.76}, {"text": "ทุกการย่อเล็กๆ", "start": 14.78, "end": 16.01}, {"text": "จะดูเหมือนการกวาด", "start": 16.07, "end": 17.37}, {"text": "นั่นคือสัญญาณรบกวนกลางกรอบ", "start": 17.66, "end": 19.57}, {"text": "ไม่ใช่", "start": 19.95, "end": 20.38}, {"text": "ซี", "start": 20.49, "end": 20.61}, {"text": "อาร์", "start": 20.71, "end": 21.27}, {"text": "ที", "start": 21.37, "end": 21.49}, {"text": "โลว์", "start": 21.59, "end": 22.15}, {"text": "เข้าซื้อตรงนั้น", "start": 22.26, "end": 23.31}, {"text": "ก็โดนสต็อปซ้ำแล้วซ้ำอีก", "start": 23.43, "end": 25.64}, {"text": "บนห้านาที", "start": 25.81, "end": 26.56}, {"text": "เซสชันเดียวกัน", "start": 27.28, "end": 28.08}, {"text": "มีการกวาดโลว์ของกรอบจริงๆ", "start": 28.35, "end": 30.04}, {"text": "แค่ครั้งเดียว", "start": 30.12, "end": 31.26}, {"text": "ตอนต่อไป", "start": 31.49, "end": 32.2}, {"text": "เช็กลิสต์", "start": 32.08, "end": 32.2}]